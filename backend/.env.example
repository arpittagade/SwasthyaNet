# Required in production; never commit the real value.
SWASTHYANET_JWT_SECRET=replace-with-a-long-random-secret

# Optional: enables real Gemini AI forecasting/insights/redistribution
# reasoning and the in-app chat assistant. If unset, the API automatically
# falls back to statistical/rule-based methods and continues to work
# normally (the assistant returns a graceful "unavailable" message).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# Optional: protects your Gemini quota from being exhausted by the live
# dashboard polling or a bursty chat user. Successful AI responses are also
# cached for GEMINI_CACHE_TTL_SECONDS so unchanged data doesn't re-call the
# API every refresh.
GEMINI_MAX_CALLS_PER_MINUTE=10
GEMINI_CACHE_TTL_SECONDS=90
CHAT_MAX_CALLS_PER_MINUTE=12

# Recommended in production: comma-separated list of exact frontend origins
# allowed to call this API, e.g. https://swasthya-india.vercel.app. If unset,
# CORS defaults to permissive (*) so the hackathon demo never breaks, but you
# should set this once you know your deployed frontend URL.
CORS_ALLOWED_ORIGINS=

# Optional: SQLite file path for persisting simulation state across
# restarts. Defaults to /tmp/swasthyanet.db if unset.
DATABASE_PATH=/tmp/swasthyanet.db
