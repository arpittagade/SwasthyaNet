# Required in production; never commit the real value.
SWASTHYANET_JWT_SECRET=replace-with-a-long-random-secret

# Optional: enables real Gemini AI forecasting/insights/redistribution
# reasoning. If unset, the API automatically falls back to the
# statistical/rule-based methods and continues to work normally.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Optional: SQLite file path for persisting simulation state across
# restarts. Defaults to /tmp/swasthyanet.db if unset.
DATABASE_PATH=/tmp/swasthyanet.db
